@{
    ViewData["Title"] = "Gestión de Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold mb-1" style="background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            <i class="bi bi-people-fill"></i> Módulo de Clientes
        </h2>
        <p class="text-muted mb-0">Gestión de perfiles de clientes, documentos de identidad y asociación empresarial.</p>
    </div>
    <div id="adminClientButtons">
        <button class="btn btn-gradient d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalCreateClient" onclick="populateEnterpriseSelect()">
            <i class="bi bi-person-plus-fill"></i> Registrar Cliente
        </button>
    </div>
</div>

<!-- Banner de Estado de Permisos según el Perfil -->
<div id="clientRoleBanner" class="alert alert-warning border-0 shadow-sm d-flex align-items-center gap-3 mb-4 rounded-3">
    <i class="bi bi-shield-lock-fill fs-3 text-warning"></i>
    <div class="flex-grow-1">
        <span class="fw-bold d-block" id="clientBannerTitle">Perfil Activo: Administrador</span>
        <small id="clientBannerDesc" class="text-muted">Tienes permisos completos para dar de alta clientes, editar perfiles y suspender cuentas.</small>
    </div>
</div>

<!-- Filtros y Búsqueda -->
<div class="card card-custom p-3 mb-4">
    <div class="row g-3 align-items-center">
        <div class="col-12 col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="clientSearchInput" class="form-control border-start-0 ps-0" placeholder="Buscar por nombre, documento o correo..." onkeyup="filterClients()">
            </div>
        </div>
        <div class="col-6 col-md-3">
            <select id="clientStatusFilter" class="form-select" onchange="loadClients(1)">
                <option value="">Todos los Estados</option>
                <option value="true" selected>Solo Activos</option>
                <option value="false">Solo Suspendidos (Baja Lógica)</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <select id="clientPageSizeSelect" class="form-select" onchange="loadClients(1)">
                <option value="5">5 por página</option>
                <option value="10" selected>10 por página</option>
                <option value="25">25 por página</option>
            </select>
        </div>
        <div class="col-12 col-md-2 text-md-end">
            <button class="btn btn-light w-100 border" onclick="loadClients(1)" title="Refrescar lista">
                <i class="bi bi-arrow-clockwise"></i> Recargar
            </button>
        </div>
    </div>
</div>

<!-- Tabla de Clientes -->
<div class="card card-custom overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-uppercase small text-muted">
                <tr>
                    <th class="ps-4">Nombres y Apellidos</th>
                    <th>Documento</th>
                    <th>Edad</th>
                    <th>Contacto</th>
                    <th>Estado</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody id="clientsTableBody">
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">
                        <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                        Cargando clientes...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center flex-wrap gap-2 px-4 py-3">
        <span class="small text-muted" id="clientPaginationInfo">Mostrando 0 de 0 registros</span>
        <nav aria-label="Paginación de clientes">
            <ul class="pagination pagination-sm mb-0" id="clientPaginationControls"></ul>
        </nav>
    </div>
</div>

<!-- MODAL: Crear Cliente -->
<div class="modal fade" id="modalCreateClient" tabindex="-1" aria-labelledby="modalCreateClientLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white" style="background: var(--primary-gradient);">
                <h5 class="modal-title fw-bold" id="modalCreateClientLabel"><i class="bi bi-person-plus-fill me-2"></i> Registrar Nuevo Cliente</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formCreateClient" onsubmit="handleCreateClient(event)">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label fw-semibold small">Nombres y Apellidos <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="createClientName" required maxlength="150" placeholder="Ej. Ana María Gómez">
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold small">Edad <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="createClientAge" required min="0" max="150" value="28">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Documento de Identidad <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="createClientDoc" required minlength="5" maxlength="50" placeholder="Ej. 1020304050">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Empresa Asociada <span class="text-danger">*</span></label>
                            <select class="form-select" id="createClientEnterprise" required>
                                <option value="">Seleccione una empresa...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Correo Electrónico <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="createClientEmail" required maxlength="150" placeholder="ana.gomez@correo.com">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Teléfono (Hasta 50 car.) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="createClientPhone" required minlength="7" maxlength="50" placeholder="Ej. +57 310 987 6543">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-gradient" id="btnSubmitCreateClient">
                        <i class="bi bi-check-circle-fill me-1"></i> Guardar Cliente
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: Editar Cliente -->
<div class="modal fade" id="modalEditClient" tabindex="-1" aria-labelledby="modalEditClientLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalEditClientLabel"><i class="bi bi-pencil-square me-2"></i> Actualizar Datos de Cliente</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formEditClient" onsubmit="handleUpdateClient(event)">
                <input type="hidden" id="editClientId">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label fw-semibold small">Nombres y Apellidos <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editClientName" required maxlength="150">
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold small">Edad <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="editClientAge" required min="0" max="150">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Documento de Identidad <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editClientDoc" required minlength="5" maxlength="50">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Empresa Asociada <span class="text-danger">*</span></label>
                            <select class="form-select" id="editClientEnterprise" required>
                                <option value="">Seleccione una empresa...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Correo Electrónico <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="editClientEmail" required maxlength="150">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Teléfono (Hasta 50 car.) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editClientPhone" required minlength="7" maxlength="50">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="btnSubmitEditClient">
                        <i class="bi bi-save me-1"></i> Actualizar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: Detalle de Cliente -->
<div class="modal fade" id="modalDetailClient" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-lines-fill me-2"></i> Perfil de Cliente</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-3">
                    <div class="d-inline-flex p-3 bg-light rounded-circle text-success mb-2">
                        <i class="bi bi-person-badge fs-1"></i>
                    </div>
                    <h5 id="detailClientName" class="fw-bold mb-0">Cliente</h5>
                    <span id="detailClientDoc" class="text-muted small">Doc: -</span>
                </div>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Edad:</span>
                        <strong id="detailClientAge">-</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Correo:</span>
                        <span id="detailClientEmail" class="text-primary">-</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Teléfono:</span>
                        <span id="detailClientPhone">-</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">ID Empresa:</span>
                        <span id="detailClientEnterpriseId" class="font-monospace small text-truncate" style="max-width: 200px;">-</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Estado Actual:</span>
                        <span id="detailClientStatus">-</span>
                    </li>
                </ul>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary w-100" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: Confirmar Suspensión de Cliente (Baja Lógica) -->
<div class="modal fade" id="modalSuspendClientConfirm" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h6 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i> Suspender Cliente</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-3">
                <p class="mb-1">¿Deseas suspender este cliente?</p>
                <strong id="suspendClientName" class="text-danger d-block mb-2">-</strong>
                <small class="text-muted">Se marcará <code>IsActive = false</code> protegiendo su historial en base de datos.</small>
            </div>
            <div class="modal-footer justify-content-center bg-light">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-sm btn-danger fw-bold" onclick="executeSuspendClient()">Suspender Cliente</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let clientsData = [];
    let currentClientPage = 1;
    let targetSuspendClientId = null;
    let enterprisesCache = [];

    function applyClientRolePermissions() {
        const role = getProfile();
        const isAdmin = role === 'Administrator';

        const banner = document.getElementById('clientRoleBanner');
        const title = document.getElementById('clientBannerTitle');
        const desc = document.getElementById('clientBannerDesc');
        const buttons = document.getElementById('adminClientButtons');

        if (isAdmin) {
            banner.className = 'alert alert-warning border-0 shadow-sm d-flex align-items-center gap-3 mb-4 rounded-3';
            title.innerText = 'Perfil Activo: Administrador';
            desc.innerText = 'Tienes permisos completos para dar de alta clientes, editar perfiles y suspender cuentas.';
            if (buttons) buttons.style.display = 'block';
        } else {
            banner.className = 'alert alert-info border-0 shadow-sm d-flex align-items-center gap-3 mb-4 rounded-3';
            title.innerText = 'Perfil Activo: Usuario Corporativo';
            desc.innerText = 'Modo Consulta: Tienes acceso de solo lectura para inspeccionar los clientes registrados.';
            if (buttons) buttons.style.display = 'none';
        }

        renderClientsTable();
    }

    async function loadClients(page = 1) {
        currentClientPage = page;
        const pageSize = document.getElementById('clientPageSizeSelect').value;
        const status = document.getElementById('clientStatusFilter').value;

        let url = `/Clients/GetPaged?pageNumber=${page}&pageSize=${pageSize}`;
        if (status !== "") url += `&onlyActive=${status}`;

        try {
            const res = await fetch(url);
            const paged = await res.json();
            clientsData = paged.data || [];

            document.getElementById('clientPaginationInfo').innerText = 
                `Mostrando página ${paged.pageNumber} de ${paged.totalPages || 1} (${paged.totalRecords} registros en total)`;

            renderClientPagination(paged.pageNumber, paged.totalPages);
            renderClientsTable();
        } catch (err) {
            console.error(err);
            showToast('Error al conectar con la base de datos de clientes.', 'danger');
        }
    }

    function renderClientsTable() {
        const tbody = document.getElementById('clientsTableBody');
        const isAdmin = getProfile() === 'Administrator';

        if (clientsData.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">
                        <i class="bi bi-person-x fs-2 d-block text-secondary mb-2"></i>
                        No se encontraron registros de clientes con los filtros aplicados.
                    </td>
                </tr>`;
            return;
        }

        let html = '';
        clientsData.forEach(item => {
            const statusBadge = item.isActive 
                ? '<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>Activo</span>'
                : '<span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1"><i class="bi bi-slash-circle-fill me-1"></i>Suspendido</span>';

            const adminActions = isAdmin ? `
                <button class="btn btn-sm btn-outline-primary" onclick="openEditClientModal('${item.id}')" title="Editar datos">
                    <i class="bi bi-pencil"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger" onclick="openSuspendClientModal('${item.id}', '${item.name}')" title="Suspender" ${!item.isActive ? 'disabled' : ''}>
                    <i class="bi bi-trash"></i>
                </button>
            ` : '';

            html += `
                <tr>
                    <td class="ps-4 fw-bold text-dark">${item.name}</td>
                    <td><span class="badge bg-light text-dark border font-monospace">${item.document}</span></td>
                    <td>${item.age} años</td>
                    <td>
                        <div class="small"><i class="bi bi-envelope text-muted me-1"></i>${item.email}</div>
                        <div class="small text-muted"><i class="bi bi-telephone text-muted me-1"></i>${item.phone}</div>
                    </td>
                    <td>${statusBadge}</td>
                    <td class="text-end pe-4">
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-sm btn-outline-secondary" onclick="openDetailClientModal('${item.id}')" title="Ver detalle">
                                <i class="bi bi-eye"></i>
                            </button>
                            ${adminActions}
                        </div>
                    </td>
                </tr>`;
        });

        tbody.innerHTML = html;
    }

    function renderClientPagination(current, total) {
        const ul = document.getElementById('clientPaginationControls');
        if (!total || total <= 1) {
            ul.innerHTML = '';
            return;
        }

        let html = `
            <li class="page-item ${current === 1 ? 'disabled' : ''}">
                <button class="page-link" onclick="loadClients(${current - 1})">Anterior</button>
            </li>`;

        for (let i = 1; i <= total; i++) {
            html += `
                <li class="page-item ${current === i ? 'active' : ''}">
                    <button class="page-link" onclick="loadClients(${i})">${i}</button>
                </li>`;
        }

        html += `
            <li class="page-item ${current === total ? 'disabled' : ''}">
                <button class="page-link" onclick="loadClients(${current + 1})">Siguiente</button>
            </li>`;

        ul.innerHTML = html;
    }

    async function populateEnterpriseSelect(selectedId = null, targetSelectId = 'createClientEnterprise') {
        try {
            if (enterprisesCache.length === 0) {
                const res = await fetch('/Clients/GetEnterprisesList');
                enterprisesCache = await res.json();
            }

            const select = document.getElementById(targetSelectId);
            select.innerHTML = '<option value="">Seleccione una empresa...</option>';
            enterprisesCache.forEach(e => {
                const opt = document.createElement('option');
                opt.value = e.id;
                opt.innerText = `${e.name} (${e.taxId})`;
                if (selectedId && e.id === selectedId) opt.selected = true;
                select.appendChild(opt);
            });
        } catch (err) {
            console.error('Error cargando empresas para clientes', err);
        }
    }

    async function handleCreateClient(e) {
        e.preventDefault();
        const payload = {
            name: document.getElementById('createClientName').value.trim(),
            age: parseInt(document.getElementById('createClientAge').value),
            document: document.getElementById('createClientDoc').value.trim(),
            enterpriseId: document.getElementById('createClientEnterprise').value,
            email: document.getElementById('createClientEmail').value.trim(),
            phone: document.getElementById('createClientPhone').value.trim()
        };

        try {
            const res = await fetch('/Clients/Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (res.status === 409) {
                const err = await res.json();
                showToast(err.message || 'Conflicto: Ya existe un cliente con ese documento o correo.', 'danger');
                return;
            }

            if (!res.ok) {
                const err = await res.json();
                showToast(err.message || 'Error de validación al crear el cliente.', 'danger');
                return;
            }

            showToast('¡Cliente registrado exitosamente!', 'success');
            bootstrap.Modal.getInstance(document.getElementById('modalCreateClient')).hide();
            document.getElementById('formCreateClient').reset();
            loadClients(1);
        } catch (err) {
            showToast('Error de conexión con el servidor.', 'danger');
        }
    }

    async function openEditClientModal(id) {
        const item = clientsData.find(x => x.id === id);
        if (!item) return;

        document.getElementById('editClientId').value = item.id;
        document.getElementById('editClientName').value = item.name;
        document.getElementById('editClientAge').value = item.age;
        document.getElementById('editClientDoc').value = item.document;
        document.getElementById('editClientEmail').value = item.email;
        document.getElementById('editClientPhone').value = item.phone;

        await populateEnterpriseSelect(item.enterpriseId, 'editClientEnterprise');

        new bootstrap.Modal(document.getElementById('modalEditClient')).show();
    }

    async function handleUpdateClient(e) {
        e.preventDefault();
        const id = document.getElementById('editClientId').value;
        const payload = {
            name: document.getElementById('editClientName').value.trim(),
            age: parseInt(document.getElementById('editClientAge').value),
            document: document.getElementById('editClientDoc').value.trim(),
            enterpriseId: document.getElementById('editClientEnterprise').value,
            email: document.getElementById('editClientEmail').value.trim(),
            phone: document.getElementById('editClientPhone').value.trim()
        };

        try {
            const res = await fetch(`/Clients/Update?id=${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (res.status === 409) {
                const err = await res.json();
                showToast(err.message || 'Conflicto: El documento o correo colisiona con otro cliente.', 'danger');
                return;
            }

            if (!res.ok) {
                const err = await res.json();
                showToast(err.message || 'Error al actualizar el cliente.', 'danger');
                return;
            }

            showToast('Cliente actualizado correctamente (200 OK).', 'success');
            bootstrap.Modal.getInstance(document.getElementById('modalEditClient')).hide();
            loadClients(currentClientPage);
        } catch (err) {
            showToast('Error de conexión con el servidor.', 'danger');
        }
    }

    function openDetailClientModal(id) {
        const item = clientsData.find(x => x.id === id);
        if (!item) return;

        document.getElementById('detailClientName').innerText = item.name;
        document.getElementById('detailClientDoc').innerText = `Doc: ${item.document}`;
        document.getElementById('detailClientAge').innerText = `${item.age} años`;
        document.getElementById('detailClientEmail').innerText = item.email;
        document.getElementById('detailClientPhone').innerText = item.phone;
        document.getElementById('detailClientEnterpriseId').innerText = item.enterpriseId || 'Sin asignar';
        document.getElementById('detailClientStatus').innerHTML = item.isActive 
            ? '<span class="badge bg-success">Activo</span>' 
            : '<span class="badge bg-danger">Suspendido</span>';

        new bootstrap.Modal(document.getElementById('modalDetailClient')).show();
    }

    function openSuspendClientModal(id, name) {
        targetSuspendClientId = id;
        document.getElementById('suspendClientName').innerText = name;
        new bootstrap.Modal(document.getElementById('modalSuspendClientConfirm')).show();
    }

    async function executeSuspendClient() {
        if (!targetSuspendClientId) return;

        try {
            const res = await fetch(`/Clients/Delete?id=${targetSuspendClientId}`, { method: 'DELETE' });
            if (!res.ok) {
                showToast('Error al suspender el cliente.', 'danger');
                return;
            }

            showToast('Cliente suspendido exitosamente (IsActive = false).', 'warning');
            bootstrap.Modal.getInstance(document.getElementById('modalSuspendClientConfirm')).hide();
            targetSuspendClientId = null;
            loadClients(currentClientPage);
        } catch (err) {
            showToast('Error al procesar la baja lógica.', 'danger');
        }
    }

    function filterClients() {
        const text = document.getElementById('clientSearchInput').value.toLowerCase();
        const rows = document.querySelectorAll('#clientsTableBody tr');
        rows.forEach(r => {
            const content = r.innerText.toLowerCase();
            r.style.display = content.includes(text) ? '' : 'none';
        });
    }

    window.addEventListener('firmezaProfileChanged', applyClientRolePermissions);

    document.addEventListener('DOMContentLoaded', () => {
        applyClientRolePermissions();
        loadClients(1);
    });
</script>
}
