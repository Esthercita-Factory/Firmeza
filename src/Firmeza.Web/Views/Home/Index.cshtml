@{
    ViewData["Title"] = "Panel Principal";
}

<!-- Componente Angular Original de Inicio -->
<div class="mb-4">
    <app-home></app-home>
</div>

<!-- Dashboard Corporativo y Accesos Rápidos según Perfil -->
<div class="container my-4">
    <div class="card card-custom p-4 mb-4 border-0 shadow-sm" style="background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <span class="badge bg-primary text-uppercase mb-2 px-3 py-1 fw-bold">Sistema Organizacional</span>
                <h3 class="fw-bold mb-1 text-dark">Bienvenido a la Plataforma Firmeza</h3>
                <p class="text-muted mb-0">Gestiona y consulta información de empresas, clientes y estructura comercial en tiempo real.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small">Tu perfil:</span>
                <span id="homeProfileBadge" class="profile-badge badge-admin">
                    <i class="bi bi-shield-lock-fill"></i> <span id="homeProfileText">Administrador</span>
                </span>
            </div>
        </div>
    </div>

    <!-- Tarjetas de Módulos -->
    <div class="row g-4 mb-4">
        <!-- Tarjeta Empresas -->
        <div class="col-12 col-md-6">
            <div class="card card-custom h-100 p-4 border-0 shadow-sm">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="p-3 rounded-3 text-white" style="background: linear-gradient(135deg, #667eea, #764ba2);">
                        <i class="bi bi-buildings fs-3"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Empresas</h4>
                        <small class="text-muted">Organizaciones, NIT y figura jurídica</small>
                    </div>
                </div>
                <p class="text-muted small mb-4">
                    Módulo para registrar empresas, actualizar razón social y nombres comerciales, y suspender registros preservando el histórico.
                </p>
                <div class="mt-auto d-flex gap-2">
                    <a asp-controller="Enterprises" asp-action="Index" class="btn btn-gradient w-100 py-2">
                        <i class="bi bi-arrow-right-circle me-1"></i> Ir a Empresas
                    </a>
                </div>
            </div>
        </div>

        <!-- Tarjeta Clientes -->
        <div class="col-12 col-md-6">
            <div class="card card-custom h-100 p-4 border-0 shadow-sm">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="p-3 rounded-3 text-white" style="background: linear-gradient(135deg, #10b981, #059669);">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Clientes</h4>
                        <small class="text-muted">Perfiles, documentos y asignación</small>
                    </div>
                </div>
                <p class="text-muted small mb-4">
                    Módulo para consultar y administrar clientes asociados a empresas, validar documentos únicos y gestionar su estado.
                </p>
                <div class="mt-auto d-flex gap-2">
                    <a asp-controller="Clients" asp-action="Index" class="btn btn-outline-success w-100 py-2 fw-bold">
                        <i class="bi bi-arrow-right-circle me-1"></i> Ir a Clientes
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Guía Interactiva de Perfiles -->
    <div class="card card-custom p-4 border-0 shadow-sm">
        <h5 class="fw-bold mb-3"><i class="bi bi-sliders me-2 text-primary"></i> Control de Acceso por Perfil</h5>
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <div class="p-3 rounded-3 border bg-light h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge badge-admin"><i class="bi bi-shield-lock-fill"></i> Perfil Administrador</span>
                        <button class="btn btn-sm btn-outline-warning text-dark fw-bold" onclick="setProfile('Administrator')">Activar</button>
                    </div>
                    <ul class="small text-muted mb-0 ps-3">
                        <li>Crear y editar empresas y clientes.</li>
                        <li>Aplicar baja lógica / suspensión (<code>IsActive = false</code>).</li>
                        <li>Ver registros activos y suspendidos.</li>
                        <li>Validación estricta de conflictos (409 Conflict).</li>
                    </ul>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="p-3 rounded-3 border bg-light h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge badge-user"><i class="bi bi-person-check-fill"></i> Perfil Usuario Corporativo</span>
                        <button class="btn btn-sm btn-outline-success fw-bold" onclick="setProfile('CorporateUser')">Activar</button>
                    </div>
                    <ul class="small text-muted mb-0 ps-3">
                        <li>Consultar lista paginada de empresas y clientes.</li>
                        <li>Inspeccionar detalles individuales por identificador (Id).</li>
                        <li>Protección contra acciones destructivas o cambios no autorizados.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/dist/browser/main.js"></script>

<script>
    function updateHomeProfile() {
        const role = getProfile();
        const badge = document.getElementById('homeProfileBadge');
        const text = document.getElementById('homeProfileText');

        if (badge && text) {
            if (role === 'Administrator') {
                badge.className = 'profile-badge badge-admin';
                text.innerText = 'Administrador (Acceso Total)';
            } else {
                badge.className = 'profile-badge badge-user';
                text.innerText = 'Usuario Corporativo (Consulta)';
            }
        }
    }

    window.addEventListener('firmezaProfileChanged', updateHomeProfile);
    document.addEventListener('DOMContentLoaded', updateHomeProfile);
</script>
