cat << 'EOF' > .env.example
# =================================================================
# Configuración de Conexión a PostgreSQL (Ejemplo)
# =================================================================
# Copia este archivo como .env y coloca tus credenciales reales aquí
DB_HOST=localhost
DB_PORT=5432
DB_NAME=firmeza
DB_USER=postgres
DB_PASSWORD=tu_contrasena_aqui

# =================================================================
# Puertos para los Contenedores
# =================================================================
API_PORT=5134
WEB_PORT=5099
EOF